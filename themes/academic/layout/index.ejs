<%
    const rotator = theme.avatar_rotator || {};
    const rotatorOn = rotator.enabled !== false;
    // The headshot loads first; the travel photos are only reachable by click.
    const headshot = rotatorOn ? (rotator.headshot || null) : null;
    const gallery = rotatorOn && Array.isArray(rotator.images) ? rotator.images : [];
    const avatarPool = (headshot ? [headshot] : []).concat(gallery);

    const posts = site.posts.sort('date', 'desc');

    // Partition once, in the template, so each section knows whether it has
    // anything to show before it renders. The previous version rendered every
    // section unconditionally and deleted the empty ones with an inline script
    // after paint, which flashed empty headings on load.
    const updateLayouts = theme.update_items || [];
    const news = posts.filter(p => updateLayouts.includes(p.layout)).limit(5);
    const projects = posts.filter(p => p.layout === 'project');
    const blogs = posts.filter(p => p.layout === 'blog');

    const selected = { conference: [], journal: [], preprint: [] };
    posts.forEach(function (p) {
        if (p.layout === 'paper' && p.selected === true && selected[p.type]) {
            selected[p.type].push(p);
        }
    });
    // Oldest-first within a group so [C1] is the earliest paper, as in a CV.
    Object.keys(selected).forEach(k => selected[k].reverse());

    const pubGroups = [
        { key: 'C', items: selected.conference },
        { key: 'J', items: selected.journal },
        { key: 'P', items: selected.preprint }
    ].filter(g => g.items.length > 0);
%>
<div class="page index">
    <%# The slot is a fixed-height grid item; the portrait inside it is taken
        out of flow and anchored to the slot's right edge. Photos therefore
        differ in width without ever resizing the grid track — which is what
        made the whole page flash on every click — and a landscape shot simply
        extends further left into the margin. %>
    <div class="header left avatar-slot">
        <div class="avatar-img" id="avatar-rotator" role="img"
             aria-label="Portrait of <%= config.name %>" data-root="<%- config.root %>">
            <% avatarPool.forEach(function (item) { %>
            <template class="avatar-option" data-src="<%= item.src %>" data-caption="<%= item.caption || '' %>"></template>
            <% }); %>
            <div class="avatar-spinner" aria-hidden="true"></div>
            <div class="avatar-caption"></div>
            <% if (avatarPool.length > 1) { %>
            <div class="avatar-hint" aria-hidden="true">click to browse</div>
            <% } %>
        </div>
        <% if (headshot && headshot.src) { %>
        <%# Only fetched when scripting is off — with JS the portrait is a CSS
            background applied by avatar.js, so this costs nothing. %>
        <noscript>
            <img class="nojs-portrait" src="<%- url_for(headshot.src) %>"
                 width="200" height="267" alt="<%= config.name %>">
        </noscript>
        <% } %>
    </div>

    <header class="header right">
        <h1><%= config.name %></h1>
        <nav class="site-nav" aria-label="Profile links">
            <ul>
                <% theme.social.forEach(function (item) { %>
                <li><a href="<%- item.url %>"><%= item.name %></a></li>
                <% }); %>
            </ul>
        </nav>
        <p class="site-bio"><%- config.description %></p>
    </header>

    <% if (avatarPool.length > 0) { %>
    <%- theme_js('js/avatar.js') %>
    <% } %>

    <% if (news.length > 0) { %>
    <h2 class="updates left">News</h2>
    <section class="updates right" aria-label="News">
        <ul class="entry-list">
            <% news.each(function (item) { %>
            <li><%- partial('_partial/article-excerpt', { item: item }) %></li>
            <% }); %>
        </ul>
    </section>
    <% } %>

    <h2 class="education left">Education</h2>
    <section class="education right" aria-label="Education">
        <ul class="info-enum">
            <% theme.info.education.forEach(function (item, idx) { %>
            <li item-tag="[E<%= theme.info.education.length - idx %>]">
                <strong><%- item.degree %></strong>, <em><%- item.institution %></em>
                <span class="entry-meta">
                    <%- item.duration %><% if (item.sub_institution) { %> &middot; <%- item.sub_institution %><% } %>
                </span>
                <% if (item.misc) { %>
                <ul>
                    <% item.misc.forEach(function (content) { %>
                    <li><%- content %></li>
                    <% }); %>
                </ul>
                <% } %>
            </li>
            <% }); %>
        </ul>
    </section>

    <h2 class="awards left">Awards</h2>
    <section class="awards right" aria-label="Awards">
        <ul class="info-enum">
            <% const awards = theme.info.awards.slice().sort((a, b) => b.year - a.year); %>
            <% awards.forEach(function (item, idx) { %>
            <li item-tag="[A<%= awards.length - idx %>]">
                <strong><%- item.name %></strong> (<%= item.year %>)
                <span class="entry-meta"><%- item.committee %></span>
            </li>
            <% }); %>
        </ul>
    </section>

    <% if (pubGroups.length > 0) { %>
    <%# The link is a sibling of the heading, not part of it: "Full list" is
        navigation, and burying it inside the <h2> put it in the heading text
        for screen readers and search engines alike. %>
    <div class="publication left">
        <h2>Selected Publications</h2>
        <a class="section-sub" href="<%- config.root %>publications">Full list</a>
    </div>
    <section class="publication right" aria-label="Selected publications">
        <ul class="info-enum">
            <% pubGroups.forEach(function (group, gi) { %>
            <% if (gi > 0) { %><hr><% } %>
            <% group.items.forEach(function (item, idx) { %>
            <li item-tag="[<%= group.key %><%= group.items.length - idx %>]">
                <a href="<%- config.root %><%- item.path %>"><strong><%= item.title %></strong></a>
                <span class="entry-meta"><%- item.venue %></span>
            </li>
            <% }); %>
            <% }); %>
        </ul>
    </section>
    <% } %>

    <% if (projects.length > 0) { %>
    <h2 class="projects left">Projects</h2>
    <section class="projects right" aria-label="Projects">
        <ul class="entry-list">
            <% projects.each(function (item) { %>
            <li><%- partial('_partial/project-excerpt', { item: item }) %></li>
            <% }); %>
        </ul>
    </section>
    <% } %>

    <% if (blogs.length > 0) { %>
    <h2 class="blogs left">Blog posts</h2>
    <section class="blogs right" aria-label="Blog posts">
        <ul class="entry-list">
            <% blogs.each(function (item) { %>
            <li><%- partial('_partial/blog-excerpt', { item: item }) %></li>
            <% }); %>
        </ul>
    </section>
    <% } %>

    <%- partial('_partial/footer') %>
    <%- partial('_partial/smart-window') %>
</div>
