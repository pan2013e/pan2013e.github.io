<div class="page">
    <%- partial('_partial/post-nav') %>
    <header class="post header right">
        <h1><%= page.title %></h1>
        <p class="paper-authors"><%- page.authors %></p>
        <% if (page.venue) { %>
        <p class="paper-venue"><%- page.venue %></p>
        <% } %>
    </header>
    <div class="rendered">
        <%- page.content %>
    </div>
    <%- partial('_partial/footer') %>
    <%- theme_js('js/format-two-columns.js') %>
</div>
