<footer class="site-footer right">
    <div class="site-prefs" id="site-prefs">
        <div class="pref-row">
            <span class="pref-label" id="pref-theme-label">Theme</span>
            <div class="pref-options" role="radiogroup" aria-labelledby="pref-theme-label">
                <button type="button" role="radio" aria-checked="false" data-theme-choice="auto">Auto</button>
                <button type="button" role="radio" aria-checked="false" data-theme-choice="light">Light</button>
                <button type="button" role="radio" aria-checked="false" data-theme-choice="dark">Dark</button>
            </div>
        </div>

        <% /* Floating windows only exist on the home page, so the control that
              governs them only appears there. */ %>
        <% if (page.layout === 'index') { %>
        <div class="pref-row">
            <span class="pref-label" id="pref-links-label">Site links open</span>
            <div class="pref-options" role="radiogroup" aria-labelledby="pref-links-label">
                <button type="button" role="radio" aria-checked="false" data-window-choice="tab">In this tab</button>
                <button type="button" role="radio" aria-checked="false" data-window-choice="window">In a floating window</button>
            </div>
        </div>
        <% } %>
    </div>

    <p class="footer-legal">
        &copy; <%= date(Date.now(), 'YYYY') %> <%= config.author %>.
        <%# The feed is a document the browser hands to a reader, not a page of
            this site: data-no-window keeps it out of the floating-window
            handler, and target="_blank" makes it behave — and be marked — like
            any other external link. %>
        <a href="<%- config.root %>rss2.xml" data-no-window target="_blank" rel="noopener">RSS</a>
    </p>
    <%- theme_js('js/prefs.js') %>
</footer>
