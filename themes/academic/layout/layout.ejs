<!doctype html>
<html lang="<%= config.language %>" dir="ltr">
<%- partial('_partial/head') %>
<body data-smart-window-default="<%= (theme.smart_window && theme.smart_window.default_enabled === false) ? 'false' : 'true' %>">
    <%- partial('_partial/nojs') %>
    <noscript>
        <p class="nojs-note">
            JavaScript is disabled, so you are seeing a simplified version of this page.
            All the content is here; the two-column layout, the portrait and the
            display settings need scripting.
        </p>
    </noscript>
    <%- body %>
</body>
</html>
